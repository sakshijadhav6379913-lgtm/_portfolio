<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sakshi Jadhav | Software Engineer</title>

    <style>

        /* =========================
           GLOBAL
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            size: A4;
            margin: 0;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #e9edf3;
            color: #1f2937;
            line-height: 1.45;
        }

        .resume {
            width: 210mm;
            min-height: 297mm;
            margin: 25px auto;
            background: white;
            padding: 32px 38px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.12);
        }


        /* =========================
           HEADER
        ========================== */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;

            padding-bottom: 18px;

            border-bottom: 3px solid #2563eb;
        }

        .name {
            font-size: 34px;
            font-weight: 800;
            color: #111827;
            letter-spacing: -0.5px;
        }

        .role {
            margin-top: 5px;

            font-size: 16px;
            font-weight: 600;

            color: #2563eb;
        }

        .tagline {
            margin-top: 5px;

            font-size: 10.5px;
            color: #6b7280;
        }

        .contact {
            text-align: right;

            font-size: 10.5px;
            line-height: 1.8;

            color: #4b5563;
        }

        .contact a {
            color: #2563eb;
            text-decoration: none;
        }

        .contact a:hover {
            text-decoration: underline;
        }


        /* =========================
           SECTIONS
        ========================== */

        .section {
            margin-top: 17px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 9px;

            font-size: 13px;
            font-weight: 800;

            color: #111827;

            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-title::before {
            content: "";
            width: 5px;
            height: 17px;

            background: #2563eb;

            border-radius: 3px;
        }

        .section-line {
            height: 1px;
            background: #e5e7eb;

            margin-top: -5px;
            margin-bottom: 10px;
        }


        /* =========================
           SUMMARY
        ========================== */

        .summary {
            font-size: 10.8px;
            color: #374151;

            text-align: justify;
        }


        /* =========================
           SKILLS
        ========================== */

        .skills-grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 8px 25px;
        }

        .skill-box {
            padding: 8px 10px;

            background: #f8fafc;

            border-left: 3px solid #2563eb;

            border-radius: 4px;
        }

        .skill-title {
            font-size: 10.5px;
            font-weight: 700;

            color: #111827;

            margin-bottom: 2px;
        }

        .skill-content {
            font-size: 10px;
            color: #4b5563;
        }


        /* =========================
           EDUCATION
        ========================== */

        .education-item {
            margin-bottom: 10px;

            padding-bottom: 8px;

            border-bottom: 1px solid #f0f1f3;
        }

        .education-item:last-child {
            border-bottom: none;
        }

        .education-header {
            display: flex;
            justify-content: space-between;

            font-size: 11.5px;
        }

        .education-header strong {
            color: #111827;
        }

        .location {
            color: #6b7280;
            font-size: 10px;
        }

        .degree {
            margin-top: 2px;

            font-size: 10.5px;
            color: #374151;
        }

        .education-details {
            margin-top: 2px;

            font-size: 9.8px;
            color: #6b7280;
        }


        /* =========================
           PROJECTS
        ========================== */

        .project {
            position: relative;

            margin-bottom: 12px;
            padding: 11px 13px;

            background: #f8fafc;

            border: 1px solid #e5e7eb;
            border-radius: 6px;
        }

        .project:hover {
            border-color: #2563eb;
        }

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .project-title {
            font-size: 12px;
            font-weight: 800;

            color: #111827;
        }

        .project-badge {
            padding: 3px 7px;

            background: #dbeafe;

            color: #1d4ed8;

            font-size: 8.5px;
            font-weight: 700;

            border-radius: 10px;
        }

        .project-link {
            margin-top: 3px;

            font-size: 9.5px;
        }

        .project-link a {
            color: #2563eb;
            text-decoration: none;
        }

        .project-description {
            margin-top: 5px;

            font-size: 10px;

            color: #4b5563;
        }

        .tech {
            margin-top: 6px;

            font-size: 9.5px;

            color: #374151;
        }

        .tech span {
            display: inline-block;

            margin-right: 5px;
            margin-top: 3px;

            padding: 3px 7px;

            background: white;

            border: 1px solid #dbe1e8;

            border-radius: 10px;

            color: #374151;
        }


        /* =========================
           EXPERIENCE
        ========================== */

        .experience {
            padding: 9px 11px;

            border-left: 3px solid #2563eb;

            background: #f8fafc;

            margin-bottom: 8px;
        }

        .experience-header {
            display: flex;
            justify-content: space-between;

            font-size: 11px;
        }

        .experience-header strong {
            color: #111827;
        }

        .date {
            color: #6b7280;
            font-size: 9.5px;
        }


        /* =========================
           TWO COLUMN
        ========================== */

        .two-column {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 30px;
        }


        /* =========================
           CERTIFICATIONS
        ========================== */

        .certification {
            padding: 8px 10px;

            background: #f8fafc;

            border-left: 3px solid #2563eb;

            font-size: 10px;
        }


        /* =========================
           SOFT SKILLS
        ========================== */

        .soft-skills {
            display: flex;
            flex-wrap: wrap;

            gap: 6px;
        }

        .soft-skill {
            padding: 5px 9px;

            background: #eff6ff;

            border: 1px solid #dbeafe;

            color: #1d4ed8;

            border-radius: 15px;

            font-size: 9.5px;
            font-weight: 600;
        }


        /* =========================
           FOOTER
        ========================== */

        .footer {
            margin-top: 15px;

            padding-top: 9px;

            border-top: 1px solid #e5e7eb;

            text-align: center;

            font-size: 8.5px;

            color: #9ca3af;
        }


        /* =========================
           PRINT
        ========================== */

        @media print {

            body {
                background: white;
            }

            .resume {
                margin: 0;
                box-shadow: none;
            }

        }


        /* =========================
           MOBILE
        ========================== */

        @media screen and (max-width: 800px) {

            .resume {
                width: 95%;
                margin: 10px auto;

                padding: 25px;
            }

            .header {
                display: block;
            }

            .contact {
                text-align: left;

                margin-top: 12px;
            }

            .skills-grid,
            .two-column {
                grid-template-columns: 1fr;
            }

            .education-header,
            .project-header,
            .experience-header {
                display: block;
            }

        }

    </style>

</head>


<body>


<div class="resume">


    <!-- ================= HEADER ================= -->

